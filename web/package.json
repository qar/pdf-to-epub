{
  "name": "pdf-to-epub-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "smoke:preview": "node scripts/preview.mjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "epubcheck-standalone": "5.4.0-build3",
    "fflate": "0.8.3",
    "idb": "8.0.4",
    "lucide-react": "^0.468.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "fake-indexeddb": "6.2.7",
    "playwright": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vitest": "^5.1.0"
  }
}
